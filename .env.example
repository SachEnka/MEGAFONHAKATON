# Local-first defaults. Copy to .env if needed. Never commit .env.

# Ollama (required for python -m local_agent)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
MAX_TOOL_ROUNDS=24

# Web fetch for open sources (0 = offline files-only)
ALLOW_WEB_FETCH=1
WEB_ALLOW_SUFFIXES=megafon.ru,wikipedia.org,github.com,habr.com

# Optional cloud search — NOT used by local_agent by default
# SEARCH_API_KEY=

# Optional cost estimation rates if you log cloud usage elsewhere
# COST_INPUT_PER_M=3
# COST_OUTPUT_PER_M=15
